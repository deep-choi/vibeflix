# Static files served by Cloudflare (Worker-rendered pages set their own headers in lib/security.ts).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Content-hashed build output (vinext only writes this rule when this file is missing, so it is repeated here)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Every page links these as /file?v=<build> (lib/security.ts), so a new deploy changes the URL and browsers
# can keep the old copy for a year. scripts/check-security.mjs fails if a file here is missing from the list.
